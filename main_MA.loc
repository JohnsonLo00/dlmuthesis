\contentsline {added}{Added~(海哥): \truncate {\Changestruncatewidth }{是鸟也，海运则将徙于南冥。}}{14}{section*.16}%
\contentsline {deleted}{Deleted~(海哥): \truncate {\Changestruncatewidth }{之乎者也。}}{14}{section*.17}%
\contentsline {replaced}{Replaced~(海老): \truncate {\Changestruncatewidth }{坳堂}}{14}{section*.18}%
\contentsline {deleted}{Deleted~(海老): \truncate {\Changestruncatewidth }{，不亦乐乎}}{15}{section*.19}%
\contentsline {highlight}{Highlighted~(海老): \truncate {\Changestruncatewidth }{故夫知效一官，行比一乡，德合一君，}}{15}{section*.20}%
\contentsline {highlight}{Highlighted~(海老): \truncate {\Changestruncatewidth }{若夫乘天地之正，而御六气之辩，以游无穷者，彼且恶乎待哉}}{15}{section*.21}%
\contentsline {comment}{Commented~(海老): \truncate {\Changestruncatewidth }{建议把落款补上}}{15}{section*.22}%
