\contentsline {added}{Added~(海哥): \truncate {\Changestruncatewidth }{是鸟也，海运则将徙于南冥。}}{6}{section*.8}%
\contentsline {deleted}{Deleted~(海哥): \truncate {\Changestruncatewidth }{之乎者也。}}{6}{section*.9}%
\contentsline {replaced}{Replaced~(海老): \truncate {\Changestruncatewidth }{坳堂}}{6}{section*.10}%
\contentsline {deleted}{Deleted~(海老): \truncate {\Changestruncatewidth }{，不亦乐乎}}{6}{section*.11}%
\contentsline {highlight}{Highlighted~(海老): \truncate {\Changestruncatewidth }{故夫知效一官，行比一乡，德合一君，}}{6}{section*.12}%
\contentsline {highlight}{Highlighted~(海老): \truncate {\Changestruncatewidth }{若夫乘天地之正，而御六气之辩，以游无穷者，彼且恶乎待哉}}{6}{section*.13}%
\contentsline {comment}{Commented~(海老): \truncate {\Changestruncatewidth }{建议把落款补上}}{6}{section*.14}%
